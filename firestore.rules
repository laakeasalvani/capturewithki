rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /content/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /heroSlides/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /portfolioShots/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /filmstripShots/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /testimonials/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Client galleries.
    //
    // The gallery document is NOT publicly readable. It holds passwordHash and
    // passwordSalt, and a public read would also let someone probe ids to learn
    // which galleries exist. The couple's page never reads it directly — the
    // openGallery function returns the title only after checking the password.
    //
    // `gal` is a claim on the custom token that function mints. Unlike the
    // Storage rules, expiry IS re-checked here: this is a single document read
    // rather than one per photo, so it is cheap enough to be worth doing.
    match /galleries/{galleryId} {
      allow read: if isAdmin() ||
        (request.auth != null
         && request.auth.token.gal == galleryId
         && resource.data.status == 'live'
         && resource.data.expiresAt > request.time);
      allow write: if isAdmin();

      // Photo records carry no secrets, so the token claim alone is the gate
      // here. The files themselves are governed by storage.rules.
      match /photos/{photoId} {
        allow read: if isAdmin() ||
          (request.auth != null && request.auth.token.gal == galleryId);
        allow write: if isAdmin();
      }

      // One record per zipped part: its size, its file name and its download
      // link. Read by the same token that reads the photos — a part record is
      // no more revealing than the photos it was made from.
      //
      // Writable by NOBODY, including her. prepareGalleryZip is the only thing
      // that may write one, and it goes through the Admin SDK, which bypasses
      // these rules. A browser that could write here could point the couple's
      // "Save all" button at any URL it liked.
      match /zips/{zipId} {
        allow read: if isAdmin() ||
          (request.auth != null && request.auth.token.gal == galleryId);
        allow write: if false;
      }
    }

    // Inquiries hold client contact details, so unlike the CMS collections
    // they are NOT publicly readable. Only the Cloud Function creates them,
    // via the Admin SDK, which bypasses these rules.
    //
    // Updates are deliberately narrow: an admin may change ONLY the status
    // and her own private note. What the client actually wrote — name,
    // email, phone, message — stays immutable to every client, including
    // her and including anyone who obtains her session.
    match /inquiries/{id} {
      allow read: if isAdmin();
      allow create, delete: if false;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['status', 'notes', 'archived', 'seenAt'])
        && (!('status' in request.resource.data)
            || request.resource.data.status in ['new', 'replied'])
        // Archiving is a separate flag, not a third status: an inquiry can be
        // archived AND still show she replied to it. Folding it into status
        // would erase that. Nothing here can delete an inquiry — `delete` is
        // still false above, so archiving only hides it from the default view.
        && (!('archived' in request.resource.data)
            || request.resource.data.archived is bool)
        && (!('notes' in request.resource.data)
            || (request.resource.data.notes is string
                && request.resource.data.notes.size() <= 5000))
        // `seenAt` records that an inquiry was actually put in front of her in
        // the dashboard. It is the only evidence the unseen-inquiry alarm has
        // (functions/lib/escalate.js), because a spam-filed email still reports
        // itself as delivered.
        //
        // Pinning it to request.time means it can only ever be written as a
        // real server timestamp at the moment of the write. It cannot be
        // backdated, and the clause is guarded by affectedKeys so that a later
        // status or notes edit, which carries the existing seenAt along
        // untouched, is not refused for failing to equal request.time.
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['seenAt'])
            || request.resource.data.seenAt == request.time);
    }

    // Kea Web Creations enquiries — a different site belonging to the same
    // owner, whose contact form posts to the keaInquiry function. Written
    // only by that function through the Admin SDK, which bypasses these
    // rules. Nothing reads them from a browser: the CaptureWithKi dashboard
    // does not know about them, and they are read in the Firebase console.
    // Closed both ways, deliberately and explicitly — an unmatched path is
    // already denied, but saying so here stops a future wildcard opening it.
    match /keaInquiries/{id} {
      allow read, write: if false;
    }

    // Dashboard-owned settings, e.g. the auto-reply email template.
    // Admin-only both ways — there is no reason for the public to read it.
    match /settings/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Spam bookkeeping, written only by the function.
    match /rateLimits/{ipHash} {
      allow read: if false;
      allow write: if false;
    }

    // A signed-in user may read ONLY their own admin marker. This is how the
    // client decides whether to show edit controls. It does not expose the
    // admin list: you can check yourself and nobody else. Writes stay closed —
    // admins are added by hand in the Firebase console.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Contracts. Clients never read Firestore directly — the signing page talks
    // only to Cloud Functions, which use the Admin SDK and bypass these rules
    // entirely. So these constrain the DASHBOARD, and the dashboard alone.
    match /contracts/{contractId} {

      // Everything that must be identical to what the client actually signed —
      // plus the three timestamps and the percentage that describe the sending
      // itself. retainerPercent is here because retainerCents is: a contract
      // whose stated percentage no longer matches the frozen amount is a
      // document that contradicts itself. sentAt and firstOpenedAt are the
      // evidence the chase ladder and the never-opened alarm reason from.
      function frozenFields() {
        return [
          'clientName', 'clientEmail', 'eventDate', 'eventLocation',
          'lineItems', 'totalCents', 'retainerCents', 'balanceCents',
          'retainerPercent',
          'templateId', 'templateVersion',
          'documentSnapshot', 'documentHash', 'tokenHash',
          'sentAt', 'firstOpenedAt', 'signedAt',
          'signature'
        ];
      }

      // Frozen from SENDING, not from signing. Keyed on signedAt, this froze one
      // step too late: through the whole window between sending and signing —
      // exactly while the client is sitting reading the agreement — an admin
      // write could still rewrite documentSnapshot, documentHash, totalCents,
      // retainerCents and tokenHash. signContract then copies the NEW
      // documentHash into the signature, binding the signature to bytes the
      // client never saw. sentAt is written in the SAME ref.update() as those
      // frozen fields and deleted in the same rollback, so it is exactly as
      // reliable a trigger as signedAt and covers strictly more.
      //
      // Everything NOT on the list above must still be writable, or the payment
      // could never be recorded and every contract would strand at 'signed'
      // while the money had already moved: status, paidAt, paymentIntent,
      // paymentSessionId, isTestPayment, paymentAnomaly/paymentAnomalyAt,
      // openCount, lastReminderAt, signReminderCount, payReminderCount,
      // neverOpenedAlertAt, escalatedAt. Adding any of those to frozenFields()
      // breaks the payment path.
      //
      // The affectedKeys() guard is load-bearing. Without it, an update that
      // merely CARRIES an unchanged frozen field is refused, which is the exact
      // bug this project already hit when seenAt was pinned to request.time.
      function frozenFieldsUnchanged() {
        return !('sentAt' in resource.data)
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny(frozenFields());
      }

      allow read:   if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() && frozenFieldsUnchanged();
      // A contract is a legal record. It is cancelled, never deleted.
      allow delete: if false;

      // Append-only, and only ever written by the Admin SDK.
      match /audit/{eventId} {
        allow read: if isAdmin();
        allow create, update, delete: if false;
      }
    }

    match /contractTemplates/{templateId} {
      allow read, write: if isAdmin();
    }

    match /packages/{packageId} {
      allow read, write: if isAdmin();
    }
  }
}
